# Copy values into the hosting provider's environment settings.
# Never commit a real .env file or production credentials.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DJANGO_SECURE_SSL_REDIRECT=False

# Temporary, high-entropy secret for the one-time live Administrator setup page.
# Configure this only in Render, then remove it after the first Administrator is created.
PROJFLOW_INITIAL_ADMIN_SETUP_TOKEN=

# Copy the Supabase Session pooler URI from Supabase > Connect.
DATABASE_URL=

# Exact public Cloudflare Pages origin, e.g. https://your-project.pages.dev
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Private Supabase Storage bucket for student report documents.
# Keep this backend-only secret key in Render; never use it in Vite.
# Current Supabase secret keys start with sb_secret_. Legacy service_role JWT keys
# are also accepted through SUPABASE_SERVICE_ROLE_KEY during migration.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-private-secret-key
PROJFLOW_REPORTS_BUCKET=projflow-project-reports
