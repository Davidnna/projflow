# Copy values into the hosting provider's environment settings.
# Never commit a real .env file or production credentials.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DJANGO_SECURE_SSL_REDIRECT=False

# Copy the Supabase Session pooler URI from Supabase > Connect.
DATABASE_URL=

# Exact public Cloudflare Pages origin, e.g. https://your-project.pages.dev
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
